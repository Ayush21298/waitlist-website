# =====================================================================
# Waitlist platform configuration
#
# Copy to .env and fill in. .env is gitignored and must never be
# committed: it holds the two access passwords and the signing secrets.
#
#   cp .env.example .env
#   npm run generate-secrets     # prints fresh SESSION_SECRET / IP_HASH_SECRET
#
# In production, prefer your host's secret store over a file on disk.
# =====================================================================

NODE_ENV=production
PORT=8080
HOST=0.0.0.0


# ---------------------------------------------------------------------
# Access passwords  (REQUIRED — the server refuses to start without them)
# ---------------------------------------------------------------------
# SITE_GATE_PASSWORD guards the whole site. Without it, holding the link
# opens nothing.
SITE_GATE_PASSWORD=

# ADMIN_PASSWORD guards the admin panel, on top of the site gate.
# It must differ from SITE_GATE_PASSWORD; the server enforces this.
ADMIN_PASSWORD=

# Set to false only if you want the landing pages to be genuinely public.
SITE_GATE_ENABLED=true


# ---------------------------------------------------------------------
# Secrets  (REQUIRED in production; at least 32 characters each)
# ---------------------------------------------------------------------
# Signs and validates sessions. Changing it logs everyone out.
SESSION_SECRET=

# Keys the HMAC that turns visitor IP addresses into pseudonyms before
# they are logged, so abuse can be correlated without retaining personal
# data. Keep it separate from SESSION_SECRET so a leaked log cannot be
# correlated with session material.
IP_HASH_SECRET=


# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (DATA_DIR below).
# That is right for local development and for any host giving you a
# persistent disk.
#
# Set it to a Postgres connection string on hosts with an ephemeral
# filesystem, where a SQLite file is wiped on every redeploy:
#   DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

DATA_DIR=./data
LOG_DIR=./logs


# ---------------------------------------------------------------------
# Behind a reverse proxy
# ---------------------------------------------------------------------
# The number of proxies in front of this server, used to read the real
# client IP from X-Forwarded-For. Get this right: too high and a client
# can forge the address that rate limiting and lockout are keyed on.
#   0  direct (local development)
#   1  one platform load balancer (most PaaS hosts)
#   2  a CDN in front of that load balancer
TRUST_PROXY_HOPS=1


# ---------------------------------------------------------------------
# Optional tuning — sensible defaults, shown for reference
# ---------------------------------------------------------------------
# LOG_LEVEL=info                  # debug | info | warn | error
# LOG_TO_FILE=true
# LOG_TO_CONSOLE=true
# EVENT_RETENTION_DAYS=365        # how long the activity trail is kept

# DEFAULT_APP_SLUG=pages          # where / redirects to

# GATE_SESSION_TTL_MS=43200000    # 12 hours
# ADMIN_SESSION_TTL_MS=28800000   # 8 hours
# ADMIN_IDLE_TIMEOUT_MS=2700000   # 45 minutes of inactivity

# RL_SIGNUP_MAX=10                # signups per IP per hour
# RL_LOGIN_MAX=8                  # password attempts per IP per 15 minutes
# RL_API_MAX=240                  # public API calls per IP per minute

# Concurrent password hashes. scrypt shares Node's thread pool with file
# reads, so raising this can make page serving slower under a login burst.
# MAX_CONCURRENT_HASHES=2

# Comma-separated origins allowed to call the API cross-origin. Empty
# means same-origin only, which is the intended deployment.
# CORS_ALLOWED_ORIGINS=
